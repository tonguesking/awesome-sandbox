{
  "name": "awesome-sandbox",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "dev:web": "vp run --filter web dev:bare",
    "deploy": "vp run --filter @awesome-sandbox/infra deploy",
    "destroy": "vp run --filter @awesome-sandbox/infra destroy",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@awesome-sandbox/config": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/node": "^26.4.1",
    "lefthook": "latest",
    "rolldown": "1.2.15",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@10.33.0"
}
